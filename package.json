{
  "name": "@jischeng/pi-provider-qoder",
  "version": "0.6.5",
  "description": "Pi extension for Qoder AI — with OAuth authentication, COSY signatures and WAF bypass",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dist/index.js": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi",
    "qoder",
    "ai",
    "provider"
  ],
  "files": [
    "dist",
    "README.md",
    "README.en.md"
  ],
  "scripts": {
    "build": "npm run build:bundle && npm run build:types",
    "build:bundle": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:@earendil-works/pi-ai --external:@earendil-works/pi-coding-agent --external:@earendil-works/pi-ai/compat",
    "build:types": "node node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "check": "node node_modules/typescript/bin/tsc --noEmit",
    "lint": "node node_modules/@biomejs/biome/bin/biome check .",
    "lint:fix": "node node_modules/@biomejs/biome/bin/biome check --write .",
    "format": "node node_modules/@biomejs/biome/bin/biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check && npm run build",
    "demo:credits": "tsx scripts/demo-credit-footer.ts",
    "test:live": "tsx scripts/record-live-fixtures.ts",
    "verify:tool-flow": "tsx scripts/verify-tool-call-flow.ts",
    "fork:diff": "grep -rn \"fork:\" src/ || true",
    "sync:upstream": "npm run fork:diff && npm run check && npm test"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@earendil-works/pi-ai": "^1.3.0",
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@earendil-works/pi-tui": "^1.3.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0",
    "vitest": "^4.1.9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jischeng/pi-provider-qoder.git"
  },
  "bugs": {
    "url": "https://github.com/jischeng/pi-provider-qoder/issues"
  },
  "homepage": "https://github.com/jischeng/pi-provider-qoder#readme"
}
